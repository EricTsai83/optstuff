# Dashboard application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DOCS_URL="http://localhost:3002"

# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/optstuff"

# Clerk
CLERK_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# API key encryption
# Generate with: openssl rand -base64 32
API_KEY_ENCRYPTION_SECRET="replace-with-at-least-32-characters"

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://replace-me.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-me"

# Cron route authentication; required in production.
CRON_SECRET="replace-with-openssl-rand-hex-32"

# Optional: success log sampling rate between 0 and 1.
REQUEST_LOG_SUCCESS_SAMPLE_RATE="1"

# Optional demo reset: weekly cleanup and expired-workspace cleanup on return.
# Missing/invalid/empty disables resets. Set your actual Clerk user ID before enabling.
# Clerk accounts are retained. Comma-separated IDs support multiple protected owners.
DEMO_RESET_PROTECTED_USER_IDS=""
# Enable only after synchronizing the database schema and configuring protected IDs.
DEMO_RESET_ENABLED="false"
